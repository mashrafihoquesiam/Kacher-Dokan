PORT=3000
DB_NAME=kaser_dokan
MONGO_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/kaser_dokan?retryWrites=true&w=majority&appName=Cluster0
AUTH_SECRET=replace-with-a-long-random-secret
PAYMENT_MODE=demo

# Cloud image storage. Copy this from Cloudinary Console > API Keys.
# Keeping this on the SERVER is important; never put the API secret in the mobile app.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Optional locally. Render provides RENDER_EXTERNAL_URL automatically after deployment.
PUBLIC_BASE_URL=

EDGE_TTS_BN_VOICE=bn-BD-NabanitaNeural
EDGE_TTS_EN_VOICE=en-US-JennyNeural
